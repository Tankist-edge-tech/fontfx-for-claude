{
  "manifest_version": 3,
  "name": "FONT/FX for Claude",
  "version": "3.4.0",
  "description": "Themes, custom colors, fonts, glitch effects and calm ambient backgrounds for claude.ai. Unofficial.",
  "permissions": [
    "storage",
    "fontSettings"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "css": [
        "theme.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FONT/FX for Claude",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "short_name": "FONT/FX"
}